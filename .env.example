# ==========================================
# GESTOR ESTRATÉGICO DE TAREAS - MATECODE
# Variables de Entorno de Ejemplo (.env.example)
# ==========================================

# ------------------------------------------
# Firebase Configuration (Cliente - Vite)
# Obtenidas en Firebase Console > Configuración del Proyecto > General > Tus apps
# ------------------------------------------
VITE_FIREBASE_API_KEY=tu_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_firebase_app_id

# ------------------------------------------
# AWS SES Configuration (Backend / Serverless Vercel Function)
# IMPORTANTE: Estas variables NO deben tener prefijo VITE_ para no exponerse en el cliente.
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_SES_SENDER_EMAIL=tu_email_verificado_en_ses@dominio.com
