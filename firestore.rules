rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección 'tasks'
    match /tasks/{taskId} {
      // Función auxiliar para comprobar si el usuario está autenticado
      function isAuthenticated() {
        return request.auth != null;
      }

      // Función auxiliar para comprobar si el recurso pertenece al usuario solicitante
      function isOwner() {
        return isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Solo los usuarios autenticados pueden listar sus propias tareas
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);

      // Solo el usuario creador puede guardar una nueva tarea con su propio userId
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Solo el dueño de la tarea puede actualizarla sin alterar el campo userId
      allow update: if isOwner() && request.resource.data.userId == request.auth.uid;

      // Solo el dueño puede eliminar su tarea
      allow delete: if isOwner();
    }

    // Por defecto, denegar cualquier otra colección no explícita
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
